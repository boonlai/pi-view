{
  "name": "pi-view",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "In-terminal file previews for Pi and Oh My Pi",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1 <0.86.0",
    "@earendil-works/pi-tui": ">=0.85.1 <0.86.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "marked": "^18.0.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
